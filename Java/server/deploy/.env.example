# LAN address of the iDispatch server container, on the lan_apps network. NGINX proxies to port 8080 on it.
IDISPATCH_IP=

# Path the application is served under. Keycloak's redirect URIs and the NGINX location must match it.
# Leave empty (IDISPATCH_CONTEXT_PATH=) to serve from the root of the host name.
IDISPATCH_CONTEXT_PATH=/idispatch

# Time zone used to show times in the UI.
TZ=Europe/Helsinki

# Password of the database user; only the server container uses it.
POSTGRES_PASSWORD=

# The external Keycloak realm and the idispatch client in it (docs/keycloak.md, "Production").
KEYCLOAK_ISSUER_URI=https://keycloak.example.com/realms/idispatch
KEYCLOAK_CLIENT_ID=idispatch
KEYCLOAK_CLIENT_SECRET=

# ASPSMS credentials for SMS dispatching. Leave empty to not send SMS.
ASPSMS_USER_KEY=
ASPSMS_PASSWORD=
ASPSMS_ORIGINATOR=iDispatch

# Language that runboards read notifications out loud in: fi or sv. It must be the language that assignment types
# and municipalities are entered in.
RUNBOARD_LANGUAGE=fi
