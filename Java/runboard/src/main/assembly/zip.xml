<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>iDispatchRunboard</id>
    <formats>
        <format>zip</format>
    </formats>
    <!-- The same folder name for every version, so that a new version can be unzipped over an old one. -->
    <baseDirectory>iDispatchRunboard</baseDirectory>
    <files>
        <file>
            <source>target/idispatch-runboard.jar</source>
        </file>
        <!-- The launchers create runboard.properties from this, so that unzipping keeps an existing one. -->
        <file>
            <source>src/main/config/runboard.properties</source>
            <destName>runboard.properties.template</destName>
        </file>
        <file>
            <source>src/main/dist/README.txt</source>
            <filtered>true</filtered>
        </file>
        <file>
            <source>../../LICENSE</source>
            <outputDirectory>licenses</outputDirectory>
        </file>
        <file>
            <source>target/generated-sources/license/THIRD-PARTY.txt</source>
            <outputDirectory>licenses</outputDirectory>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>src/main/dist</directory>
            <outputDirectory/>
            <includes>
                <include>*.command</include>
            </includes>
            <lineEnding>unix</lineEnding>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/dist</directory>
            <outputDirectory/>
            <includes>
                <include>*.cmd</include>
            </includes>
            <lineEnding>dos</lineEnding>
        </fileSet>
        <fileSet>
            <directory>src/main/dist/licenses</directory>
            <outputDirectory>licenses</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>target/notices</directory>
            <outputDirectory>licenses/notices</outputDirectory>
            <includes>
                <include>*/*</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
